# WeatherWise Events - Frontend (.env.example)
# Copy to ".env" and adjust for your environment.
# Only variables prefixed with REACT_APP_ are exposed to the browser.

# Base URL for the backend API. If omitted, the frontend will call same-origin
# paths (e.g., /api/weather/current), suitable when you proxy requests via dev server.
# Development (backend on 8000):
REACT_APP_API_BASE_URL=http://localhost:8000
