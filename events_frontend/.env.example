# WeatherWise Events - Frontend (.env.example)
# Copy this file to `.env` and adjust values for your environment.

# Point the frontend to the FastAPI backend base URL.
# Development defaults:
#   Backend: http://localhost:8000
#   Frontend: http://localhost:3000
REACT_APP_API_BASE_URL=http://localhost:8000

# If you serve frontend and backend from the same origin via a reverse proxy,
# you can remove REACT_APP_API_BASE_URL and rely on relative paths (/api/...).
# In that case ensure your proxy forwards /api/* to the backend.

# Optional: Toggle verbose API logs during development (true/false).
REACT_APP_API_DEBUG=true
